# Copy to .env and fill in. Key from https://console.deepgram.com.
# No Early Access flag needed: Flux TTS went generally available on the cloud API on 2026-08-12.
# (Self-hosted Flux is still Early Access. This project only talks to the cloud API.)
DEEPGRAM_API_KEY=your_key_here

# Needed for `--writer claude`, which is the writer the nightly cron uses. Optional locally only
# because `--writer panel` is deterministic and offline; on a deployed machine that runs the cron,
# scripts/daily.py imports ClaudeWriter at module scope and dies without this.
# ANTHROPIC_API_KEY=your_key_here

# Optional: set to 0 to render speech only, with no intro cue, stings or cold-open bed.
# Anything but 0/false/no/off leaves music on, so a typo here cannot silently ship a bare show.
# --music / --no-music on `python -m hn_radio` overrides this for a single run.
# HN_RADIO_MUSIC=0

# Optional: absolute origin for the RSS enclosures + subscribe links.
# Defaults to http://localhost:8000/episodes, so an imported local feed plays as-is.
# Set this when you deploy, or the feed will point subscribers at your laptop.
# The value must include the /episodes path segment.
# HN_RADIO_BASE_URL=https://hn-radio-<you>.fly.dev/episodes

# Optional: where scripts/daily.py reports a failed or rejected run. Read from the process
# environment only, not from this file, so set them as Fly secrets or shell exports. A Slack or
# Discord incoming webhook, and/or a Pushover application token + user key (both required).
# HN_RADIO_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# HN_RADIO_PUSHOVER_TOKEN=your_application_token
# HN_RADIO_PUSHOVER_USER=your_user_key
