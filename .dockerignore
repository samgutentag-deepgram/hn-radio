# Keep the build context lean. The image needs the six directories the Dockerfile COPYs
# (hn_radio/, backend/, web/, scripts/, episodes/, assets/) plus pyproject.toml, uv.lock and
# .python-version for `uv sync`. The Dockerfile's COPY lines are the authority on that list; this
# file only says what must never enter the context.
.git
.venv
__pycache__
*.pyc
.pytest_cache
.env
.env.example
sample.env
tests
docs
deploy
*.md
fly.toml

# Tooling directories. None of these are COPYd, and left in they dominate the context: the
# 2026-08-18 deploy uploaded 486 MB across 680 files, and .claude alone was 270 MB of it, more
# than episodes/. These are local build-time directories; none of them exist in a fresh clone.
.claude
.render-cache
.superpowers
.hub
.github

# ship the chaptered MP3 + per-segment PCM cache; the source WAV is not needed at runtime
episodes/**/episode.wav

# The play counter's log. It is per-DEPLOYMENT data that belongs to the volume, and a developer's
# local copy baked into the image would be copied onto an empty volume by the entrypoint on first
# boot -- publishing a fake play history as if it were real. The volume's own copy is authoritative
# and the app creates the file when it needs it.
episodes/plays.jsonl
episodes/plays-*.jsonl
episodes/plays-totals.json
